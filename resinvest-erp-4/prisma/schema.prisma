// ResInvest ERP 4 — model danych PostgreSQL
//
// Zasady:
//  * klucze UUID v7 (uporządkowane w czasie), znaczniki czasu `timestamptz` w UTC,
//  * ilości `numeric(18,6)`, kwoty `numeric(14,2)`, przeliczniki `numeric(12,6)` — bez liczb zmiennoprzecinkowych,
//  * stan magazynu wynika wyłącznie z `stock_movements` (append-only); `stock_balances` to saldo utrzymywane
//    w tej samej transakcji pod blokadą wiersza (SELECT … FOR UPDATE) z CHECK qty >= 0,
//  * `version` = optimistic locking dla rekordów edytowalnych, `deleted_at` = soft delete,
//  * ograniczenia, których Prisma nie wyraża (CHECK, indeksy częściowe, blokada zmian audytu),
//    są w migracjach SQL (prisma/migrations/*/migration.sql).

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Słowniki (enumy)
// ============================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Unit {
  M3
  MP
  T
}

/// Źródło wartości przeliczonej: przelicznik automatyczny materiału, wpis ręczny, przelicznik firmowy.
enum ValueSource {
  AUTO
  MANUAL
  COMPANY_RATE
}

enum MaterialCategory {
  WOOD
  CHIPS
  TONNAGE
  OTHER
}

enum PartnerRole {
  SUPPLIER
  BUYER
  BOTH
}

enum PartnerKind {
  COMPANY
  FOREST_DISTRICT
}

enum Ownership {
  OWN
  EXTERNAL
}

enum AssetStatus {
  ACTIVE
  SERVICE
  RETIRED
}

enum ExternalCompanyKind {
  TRANSPORT
  CHIPPING
  SERVICES
  OTHER
}

enum OperationType {
  PURCHASE
  SALE
  PRODUCTION
  TRANSFER
  OPENING_BALANCE
  INVENTORY
}

enum OperationStatus {
  DRAFT
  PENDING
  POSTED
  CORRECTED
  DELETED
}

enum DocumentType {
  PZ
  WZ
  RW
  PW
  MM
  TR
  BO
  IN
}

enum MovementKind {
  OPENING
  PURCHASE
  SALE
  CONSUMPTION
  PRODUCTION
  TRANSFER_OUT
  TRANSFER_IN
  INVENTORY
  CORRECTION
  REVERSAL
}

enum TransferState {
  IN_TRANSIT
  RECEIVED
}

enum TransportMode {
  NONE
  OWN
  EXTERNAL
  MIXED
  TRAIN
  SUPPLIER
}

enum ProductionMode {
  FROM_STOCK
  FROM_PURCHASE
  DIRECT
}

enum OpeningBatchStatus {
  DRAFT
  APPROVED
}

enum InventoryStatus {
  OPEN
  CLOSED
}

enum AuthTokenKind {
  INVITE
  PASSWORD_RESET
  EMAIL_CONFIRM
}

enum NotificationEvent {
  PZ_CREATED
  WZ_CREATED
  PRODUCTION_CREATED
  STOCK_OPERATION
  CORRECTION
  DOCUMENT_EDITED
  DOCUMENT_DELETED
  ADDITIONAL_OPERATION
}

enum MailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
}

enum BackupKind {
  SCHEDULED
  MANUAL
  ON_SHUTDOWN
}

enum BackupStatus {
  RUNNING
  OK
  FAILED
}

// ============================================================================
// Tożsamość, role, uprawnienia, sesje
// ============================================================================

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique @db.VarChar(40)
  name        String           @db.VarChar(80)
  description String?
  /// Rola z dostępem do wszystkich magazynów (ADMINISTRATOR, AUDYTOR).
  global      Boolean          @default(false)
  /// Rola systemowa — nie można jej usunąć.
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int              @default(1)
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  code        String           @id @db.VarChar(60)
  description String
  group       String           @db.VarChar(40)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(60)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model User {
  id                 String          @id @default(uuid(7)) @db.Uuid
  /// E-mail firmowy — podstawowy identyfikator (zawsze małymi literami; CHECK w migracji).
  email              String          @unique @db.VarChar(254)
  firstName          String          @map("first_name") @db.VarChar(80)
  lastName           String          @map("last_name") @db.VarChar(80)
  status             UserStatus      @default(INVITED)
  roleId             String          @map("role_id") @db.Uuid
  defaultWarehouseId String?         @map("default_warehouse_id") @db.Uuid
  /// Język interfejsu: pl / cs / en (CHECK w migracji).
  lang               String          @default("pl") @db.VarChar(5)
  /// Motyw: pearl / graphite / azure / ultra / premium / custom; puste = motyw domyślny (Perła).
  theme              String?         @db.VarChar(20)
  /// Motyw własny: kolor przewodni i kolor tła (#rrggbb, małe litery).
  themePrimary       String?         @map("theme_primary") @db.VarChar(7)
  themeSecondary     String?         @map("theme_secondary") @db.VarChar(7)
  passwordHash       String?         @map("password_hash")
  passwordChangedAt  DateTime?       @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  /// Konto zgłoszone z ekranu rejestracji (czeka na zatwierdzenie przez administratora).
  selfRegistered     Boolean         @default(false) @map("self_registered")
  failedLogins       Int             @default(0) @map("failed_logins")
  lockedUntil        DateTime?       @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?       @map("last_login_at") @db.Timestamptz(3)
  /// Przygotowanie pod Entra ID / LDAP: dostawca i identyfikator zewnętrzny.
  identityProvider   String          @default("local") @map("identity_provider") @db.VarChar(30)
  externalId         String?         @map("external_id") @db.VarChar(200)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById        String?         @map("created_by_id") @db.Uuid
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int             @default(1)

  role                 Role                  @relation(fields: [roleId], references: [id])
  defaultWarehouse     Warehouse?            @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  warehouses           UserWarehouse[]
  sessions             Session[]
  authTokens           AuthToken[]
  notificationSettings NotificationSetting[]

  @@unique([identityProvider, externalId])
  @@index([status])
  @@map("users")
}

model UserWarehouse {
  userId      String    @map("user_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  /// SHA-256 tokenu sesji — sam token jest tylko w ciasteczku HttpOnly.
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(300)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(80)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id          String        @id @default(uuid(7)) @db.Uuid
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  userId      String        @map("user_id") @db.Uuid
  kind        AuthTokenKind
  email       String?       @db.VarChar(254)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?       @map("created_by_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("auth_tokens")
}

model LoginEvent {
  id        BigInt   @id @default(autoincrement())
  ts        DateTime @default(now()) @db.Timestamptz(3)
  email     String   @db.VarChar(254)
  userId    String?  @map("user_id") @db.Uuid
  success   Boolean
  reason    String?  @db.VarChar(60)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(300)

  @@index([email, ts])
  @@index([ts])
  @@map("login_events")
}

// ============================================================================
// Konfiguracja
// ============================================================================

model Setting {
  key         String   @id @db.VarChar(80)
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid
  version     Int      @default(1)

  @@map("settings")
}

// ============================================================================
// Kartoteki
// ============================================================================

model Warehouse {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @unique @db.VarChar(120)
  address   String?  @db.VarChar(250)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(1)

  defaultForUsers      User[]                 @relation("UserDefaultWarehouse")
  users                UserWarehouse[]
  operations           Operation[]            @relation("OperationWarehouse")
  incomingTransfers    Operation[]            @relation("OperationTargetWarehouse")
  documents            Document[]
  movements            StockMovement[]
  balances             StockBalance[]
  openingBatches       OpeningBalanceBatch[]
  inventoryPeriods     InventoryPeriod[]
  additionalOperations AdditionalOperation[]
  vehicles             Vehicle[]
  chippers             Chipper[]
  purchasePlans        PurchasePlan[]

  @@map("warehouses")
}

model Material {
  id           String           @id @default(uuid(7)) @db.Uuid
  code         String           @unique @db.VarChar(20)
  name         String           @unique @db.VarChar(160)
  category     MaterialCategory
  /// Jednostka ewidencji stanu (niezmienna po pierwszym ruchu — pilnuje API).
  stockUnit    Unit             @map("stock_unit")
  /// Jednostki dozwolone na dokumentach (zawsze zawiera jednostkę magazynową).
  allowedUnits Unit[]           @map("allowed_units")
  /// Masa 1 jednostki magazynowej [t] (m³, MP); null = przelicznik firmowy.
  tonPerUnit   Decimal?         @map("ton_per_unit") @db.Decimal(12, 6)
  /// MP z 1 m³ dla tego materiału; null = przelicznik firmowy.
  mpPerM3      Decimal?         @map("mp_per_m3") @db.Decimal(12, 6)
  /// Gęstość t/m³ dla materiałów w tonach kupowanych w m³ / MP.
  tonPerM3     Decimal?         @map("ton_per_m3") @db.Decimal(12, 6)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int              @default(1)

  conversionRates ConversionRate[]
  documentLines   DocumentLine[]
  movements       StockMovement[]
  balances        StockBalance[]
  openingLines    OpeningBalanceLine[]

  @@map("materials")
}

/// Przeliczniki firmowe (materialId = null → dla całej firmy), wersjonowane datą obowiązywania.
model ConversionRate {
  id          String    @id @default(uuid(7)) @db.Uuid
  materialId  String?   @map("material_id") @db.Uuid
  fromUnit    Unit      @map("from_unit")
  toUnit      Unit      @map("to_unit")
  factor      Decimal   @db.Decimal(12, 6)
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  material    Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([materialId, fromUnit, toUnit, validFrom])
  @@map("conversion_rates")
}

model Partner {
  id               String      @id @default(uuid(7)) @db.Uuid
  name             String      @db.VarChar(200)
  nip              String?     @db.VarChar(15)
  role             PartnerRole
  kind             PartnerKind @default(COMPANY)
  city             String?     @db.VarChar(120)
  address          String?     @db.VarChar(250)
  /// Leśnictwa nadleśnictwa (dopisywane przy zakupach).
  forestries       String[]    @default([])
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById      String?     @map("created_by_id") @db.Uuid
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int         @default(1)
  documents        Document[]

  @@unique([name])
  @@index([nip])
  @@map("partners")
}

/// Firmy zewnętrzne: przewoźnicy, firmy rębiące, usługi.
model ExternalCompany {
  id        String              @id @default(uuid(7)) @db.Uuid
  name      String              @unique @db.VarChar(200)
  nip       String?             @db.VarChar(15)
  kind      ExternalCompanyKind
  contact   String?             @db.VarChar(250)
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int                 @default(1)
  vehicles  Vehicle[]
  chippers  Chipper[]
  runs      TransportRun[]

  @@map("external_companies")
}

model Driver {
  id           String         @id @default(uuid(7)) @db.Uuid
  name         String         @db.VarChar(120)
  phone        String?        @db.VarChar(30)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int            @default(1)
  vehicles     Vehicle[]
  runs         TransportRun[]

  @@map("drivers")
}

model Operator {
  id              String           @id @default(uuid(7)) @db.Uuid
  name            String           @db.VarChar(120)
  phone           String?          @db.VarChar(30)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int              @default(1)
  chippers        Chipper[]
  productionRuns  ProductionRun[]

  @@map("operators")
}

model Vehicle {
  id                String           @id @default(uuid(7)) @db.Uuid
  name              String           @db.VarChar(120)
  registration      String           @unique @db.VarChar(20)
  vehicleType       String?          @map("vehicle_type") @db.VarChar(40)
  ownership         Ownership        @default(OWN)
  externalCompanyId String?          @map("external_company_id") @db.Uuid
  status            AssetStatus      @default(ACTIVE)
  /// null = pojazd wspólny dla wszystkich magazynów.
  warehouseId       String?          @map("warehouse_id") @db.Uuid
  defaultDriverId   String?          @map("default_driver_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int              @default(1)

  externalCompany      ExternalCompany?      @relation(fields: [externalCompanyId], references: [id])
  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id])
  defaultDriver        Driver?               @relation(fields: [defaultDriverId], references: [id])
  runs                 TransportRun[]
  additionalOperations AdditionalOperation[]

  @@map("vehicles")
}

/// Rębaki własne i firm zewnętrznych (CHECK: EXTERNAL ⇒ firma wymagana).
model Chipper {
  id                String           @id @default(uuid(7)) @db.Uuid
  name              String           @db.VarChar(120)
  registration      String?          @db.VarChar(20)
  ownership         Ownership        @default(OWN)
  externalCompanyId String?          @map("external_company_id") @db.Uuid
  operatorId        String?          @map("operator_id") @db.Uuid
  /// Operator firmy zewnętrznej (bez kartoteki operatorów).
  externalOperator  String?          @map("external_operator") @db.VarChar(120)
  notes             String?
  status            AssetStatus      @default(ACTIVE)
  warehouseId       String?          @map("warehouse_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int              @default(1)

  externalCompany ExternalCompany? @relation(fields: [externalCompanyId], references: [id])
  operator        Operator?        @relation(fields: [operatorId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  productionRuns  ProductionRun[]

  @@map("chippers")
}

/// Kartoteki → Dodatkowe operacje (holowanie, podgarnianie pryzm, czyszczenie placu…).
model AdditionalOperationType {
  id           String                @id @default(uuid(7)) @db.Uuid
  name         String                @unique @db.VarChar(120)
  description  String?
  unit         String?               @db.VarChar(20)
  defaultRate  Decimal?              @map("default_rate") @db.Decimal(14, 2)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int                   @default(1)
  operations   AdditionalOperation[]

  @@map("additional_operation_types")
}

// ============================================================================
// Operacje i dokumenty
// ============================================================================

/// Operacja biznesowa (zakup, sprzedaż, produkcja na magazynie, MM, bilans otwarcia, inwentaryzacja).
/// Jedna operacja = jedna transakcja bazodanowa; łączy dokumenty, ruchy, transport i operacje dodatkowe.
model Operation {
  id                String          @id @default(uuid(7)) @db.Uuid
  type              OperationType
  status            OperationStatus @default(POSTED)
  warehouseId       String          @map("warehouse_id") @db.Uuid
  /// MM: magazyn docelowy.
  targetWarehouseId String?         @map("target_warehouse_id") @db.Uuid
  transferState     TransferState?  @map("transfer_state")
  operationDate     DateTime        @map("operation_date") @db.Date
  /// Klucz idempotencji żądania — powtórzone wysłanie formularza nie tworzy drugiej operacji.
  idempotencyKey    String          @unique @map("idempotency_key") @db.VarChar(80)
  transportMode     TransportMode   @default(NONE) @map("transport_mode")
  place             String?         @db.VarChar(250)
  notes             String?
  purchaseCost      Decimal         @default(0) @map("purchase_cost") @db.Decimal(14, 2)
  revenue           Decimal         @default(0) @db.Decimal(14, 2)
  chippingCost      Decimal         @default(0) @map("chipping_cost") @db.Decimal(14, 2)
  transportCost     Decimal         @default(0) @map("transport_cost") @db.Decimal(14, 2)
  additionalCost    Decimal         @default(0) @map("additional_cost") @db.Decimal(14, 2)
  /// Migawka danych formularza (do korekty i odtworzenia widoku).
  input             Json?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String          @map("created_by_id") @db.Uuid
  postedAt          DateTime?       @map("posted_at") @db.Timestamptz(3)
  postedById        String?         @map("posted_by_id") @db.Uuid
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int             @default(1)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  deletedById       String?         @map("deleted_by_id") @db.Uuid
  deleteReason      String?         @map("delete_reason")

  warehouse            Warehouse             @relation("OperationWarehouse", fields: [warehouseId], references: [id])
  targetWarehouse      Warehouse?            @relation("OperationTargetWarehouse", fields: [targetWarehouseId], references: [id])
  documents            Document[]
  movements            StockMovement[]
  transportRuns        TransportRun[]
  productionRun        ProductionRun?
  additionalOperations AdditionalOperation[]
  transferReceipt      TransferReceipt?
  corrections          Correction[]
  revisions            DocumentRevision[]

  @@index([warehouseId, operationDate])
  @@index([targetWarehouseId, transferState])
  @@index([type, operationDate])
  @@index([deletedAt])
  @@map("operations")
}

/// Dokument magazynowy. Numer PZ/WZ wpisuje użytkownik (program podpowiada kolejny wolny);
/// unikalność: typ + magazyn + rok. Każdy dokument ma też wewnętrzny identyfikator UUID.
model Document {
  id             String          @id @default(uuid(7)) @db.Uuid
  operationId    String          @map("operation_id") @db.Uuid
  type           DocumentType
  number         String          @db.VarChar(40)
  year           Int
  warehouseId    String          @map("warehouse_id") @db.Uuid
  /// Data dokumentu (z papieru).
  documentDate   DateTime        @map("document_date") @db.Date
  /// Data przyjęcia / wydania towaru.
  movementDate   DateTime        @map("movement_date") @db.Date
  partnerId      String?         @map("partner_id") @db.Uuid
  externalNumber String?         @map("external_number") @db.VarChar(60)
  status         OperationStatus @default(POSTED)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String          @map("created_by_id") @db.Uuid
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int             @default(1)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)

  operation Operation      @relation(fields: [operationId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  partner   Partner?       @relation(fields: [partnerId], references: [id])
  lines     DocumentLine[]
  movements StockMovement[]
  revisions DocumentRevision[]

  @@unique([type, warehouseId, year, number])
  @@index([warehouseId, documentDate])
  @@index([partnerId])
  @@index([operationId])
  @@map("documents")
}

/// Pozycja dokumentu: ilość źródłowa i przeliczona, zastosowany przelicznik i jego źródło, tonaż i jego źródło.
model DocumentLine {
  id               String       @id @default(uuid(7)) @db.Uuid
  documentId       String       @map("document_id") @db.Uuid
  lineNo           Int          @map("line_no")
  materialId       String       @map("material_id") @db.Uuid
  qtySource        Decimal      @map("qty_source") @db.Decimal(18, 6)
  unitSource       Unit         @map("unit_source")
  qtyStock         Decimal      @map("qty_stock") @db.Decimal(18, 6)
  unitStock        Unit         @map("unit_stock")
  conversionFactor Decimal      @map("conversion_factor") @db.Decimal(12, 6)
  conversionSource ValueSource  @map("conversion_source")
  weightT          Decimal?     @map("weight_t") @db.Decimal(18, 6)
  weightSource     ValueSource? @map("weight_source")
  unitPrice        Decimal?     @map("unit_price") @db.Decimal(14, 4)
  priceUnit        Unit?        @map("price_unit")
  value            Decimal?     @db.Decimal(14, 2)

  document  Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  material  Material        @relation(fields: [materialId], references: [id])
  movements StockMovement[]

  @@unique([documentId, lineNo])
  @@index([materialId])
  @@map("document_lines")
}

/// Ruch magazynowy — jedyne źródło stanu. Tylko INSERT (UPDATE/DELETE zablokowane wyzwalaczem).
model StockMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  seq            BigInt       @unique @default(autoincrement())
  warehouseId    String       @map("warehouse_id") @db.Uuid
  materialId     String       @map("material_id") @db.Uuid
  operationId    String       @map("operation_id") @db.Uuid
  documentId     String?      @map("document_id") @db.Uuid
  documentLineId String?      @map("document_line_id") @db.Uuid
  kind           MovementKind
  /// Zmiana stanu w jednostce magazynowej materiału (≠ 0).
  qty            Decimal      @db.Decimal(18, 6)
  movementDate   DateTime     @map("movement_date") @db.Date
  reversalOfId   String?      @map("reversal_of_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String       @map("created_by_id") @db.Uuid

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  material     Material      @relation(fields: [materialId], references: [id])
  operation    Operation     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  document     Document?     @relation(fields: [documentId], references: [id])
  documentLine DocumentLine? @relation(fields: [documentLineId], references: [id])

  @@index([warehouseId, materialId, movementDate])
  @@index([operationId])
  @@map("stock_movements")
}

/// Saldo magazyn × materiał — aktualizowane w tej samej transakcji co ruch, pod blokadą wiersza.
model StockBalance {
  warehouseId String    @map("warehouse_id") @db.Uuid
  materialId  String    @map("material_id") @db.Uuid
  qty         Decimal   @default(0) @db.Decimal(18, 6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  material    Material  @relation(fields: [materialId], references: [id])

  @@id([warehouseId, materialId])
  @@map("stock_balances")
}

// ============================================================================
// Bilans otwarcia (Administracja → Dane startowe)
// ============================================================================

model OpeningBalanceBatch {
  id            String             @id @default(uuid(7)) @db.Uuid
  warehouseId   String             @map("warehouse_id") @db.Uuid
  effectiveDate DateTime           @map("effective_date") @db.Date
  status        OpeningBatchStatus @default(DRAFT)
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String             @map("created_by_id") @db.Uuid
  approvedAt    DateTime?          @map("approved_at") @db.Timestamptz(3)
  approvedById  String?            @map("approved_by_id") @db.Uuid
  /// Operacja księgująca bilans (po zatwierdzeniu).
  operationId   String?            @unique @map("operation_id") @db.Uuid
  version       Int                @default(1)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  lines         OpeningBalanceLine[]

  @@index([warehouseId, status])
  @@map("opening_balance_batches")
}

model OpeningBalanceLine {
  id         String              @id @default(uuid(7)) @db.Uuid
  batchId    String              @map("batch_id") @db.Uuid
  materialId String              @map("material_id") @db.Uuid
  qty        Decimal             @db.Decimal(18, 6)
  unit       Unit
  qtyStock   Decimal             @map("qty_stock") @db.Decimal(18, 6)
  note       String?
  batch      OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  material   Material            @relation(fields: [materialId], references: [id])

  @@unique([batchId, materialId])
  @@map("opening_balance_lines")
}

// ============================================================================
// Szczegóły operacji: transport, produkcja, operacje dodatkowe, przyjęcie MM
// ============================================================================

model TransportRun {
  id                String           @id @default(uuid(7)) @db.Uuid
  operationId       String           @map("operation_id") @db.Uuid
  runNo             Int              @map("run_no")
  ownership         Ownership
  vehicleId         String?          @map("vehicle_id") @db.Uuid
  driverId          String?          @map("driver_id") @db.Uuid
  externalCompanyId String?          @map("external_company_id") @db.Uuid
  registration      String?          @db.VarChar(20)
  driverName        String?          @map("driver_name") @db.VarChar(120)
  km                Decimal          @default(0) @db.Decimal(10, 2)
  ratePerKm         Decimal?         @map("rate_per_km") @db.Decimal(10, 2)
  freight           Decimal?         @db.Decimal(14, 2)
  cost              Decimal          @default(0) @db.Decimal(14, 2)
  qty               Decimal?         @db.Decimal(18, 6)
  unit              Unit?
  weightT           Decimal?         @map("weight_t") @db.Decimal(18, 6)
  waybillNo         String?          @map("waybill_no") @db.VarChar(60)
  waybillM3         Decimal?         @map("waybill_m3") @db.Decimal(18, 6)
  /// Kolej: numer składu, przewoźnik, wagony, tonaż (szczegóły w JSON — zestaw wagonów).
  train             Json?

  operation       Operation        @relation(fields: [operationId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  driver          Driver?          @relation(fields: [driverId], references: [id])
  externalCompany ExternalCompany? @relation(fields: [externalCompanyId], references: [id])

  @@unique([operationId, runNo])
  @@map("transport_runs")
}

model ProductionRun {
  id             String         @id @default(uuid(7)) @db.Uuid
  operationId    String         @unique @map("operation_id") @db.Uuid
  mode           ProductionMode
  rawMaterialId  String?        @map("raw_material_id") @db.Uuid
  outMaterialId  String         @map("out_material_id") @db.Uuid
  consumeQty     Decimal?       @map("consume_qty") @db.Decimal(18, 6)
  outQty         Decimal        @map("out_qty") @db.Decimal(18, 6)
  factor         Decimal?       @db.Decimal(12, 6)
  chipperId      String?        @map("chipper_id") @db.Uuid
  operatorId     String?        @map("operator_id") @db.Uuid
  chipRate       Decimal?       @map("chip_rate") @db.Decimal(10, 2)
  chippingCost   Decimal        @default(0) @map("chipping_cost") @db.Decimal(14, 2)
  diffReason     String?        @map("diff_reason") @db.VarChar(40)
  forestDistrict String?        @map("forest_district") @db.VarChar(120)
  forestry       String?        @db.VarChar(120)
  waybill        String?        @db.VarChar(200)
  investSite     String?        @map("invest_site") @db.VarChar(250)
  sourceDoc      String?        @map("source_doc") @db.VarChar(120)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  chipper   Chipper?  @relation(fields: [chipperId], references: [id])
  operator  Operator? @relation(fields: [operatorId], references: [id])

  @@map("production_runs")
}

/// Operacja dodatkowa (holowanie, praca ładowarką…) — osobny rekord z FK do operacji głównej.
model AdditionalOperation {
  id          String                  @id @default(uuid(7)) @db.Uuid
  operationId String                  @map("operation_id") @db.Uuid
  typeId      String                  @map("type_id") @db.Uuid
  warehouseId String                  @map("warehouse_id") @db.Uuid
  vehicleId   String?                 @map("vehicle_id") @db.Uuid
  performedOn DateTime                @map("performed_on") @db.Date
  quantity    Decimal?                @db.Decimal(14, 3)
  cost        Decimal                 @db.Decimal(14, 2)
  description String?
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String                  @map("created_by_id") @db.Uuid
  deletedAt   DateTime?               @map("deleted_at") @db.Timestamptz(3)

  operation Operation               @relation(fields: [operationId], references: [id], onDelete: Restrict)
  type      AdditionalOperationType @relation(fields: [typeId], references: [id])
  warehouse Warehouse               @relation(fields: [warehouseId], references: [id])
  vehicle   Vehicle?                @relation(fields: [vehicleId], references: [id])

  @@index([warehouseId, performedOn])
  @@index([operationId])
  @@map("additional_operations")
}

/// Przyjęcie MM (tryb dwuetapowy): ilość faktyczna, różnica i jej przyczyna, tonaż.
model TransferReceipt {
  id             String       @id @default(uuid(7)) @db.Uuid
  operationId    String       @unique @map("operation_id") @db.Uuid
  receivedDate   DateTime     @map("received_date") @db.Date
  qty            Decimal      @db.Decimal(18, 6)
  unit           Unit
  qtyStock       Decimal      @map("qty_stock") @db.Decimal(18, 6)
  /// wysłano − przyjęto (jednostka magazynowa): > 0 ubytek, < 0 nadwyżka.
  diffStock      Decimal      @map("diff_stock") @db.Decimal(18, 6)
  reason         String?      @db.VarChar(40)
  note           String?
  weightT        Decimal?     @map("weight_t") @db.Decimal(18, 6)
  weightSource   ValueSource? @map("weight_source")
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(80)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String       @map("created_by_id") @db.Uuid
  operation      Operation    @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@map("transfer_receipts")
}

// ============================================================================
// Korekty i historia zmian (BYŁO / JEST)
// ============================================================================

model Correction {
  id          String   @id @default(uuid(7)) @db.Uuid
  operationId String   @map("operation_id") @db.Uuid
  number      String   @unique @db.VarChar(40)
  reason      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String   @map("created_by_id") @db.Uuid
  /// Odwraca wcześniejszą korektę (numer).
  reverses    String?  @db.VarChar(40)
  /// Klucz idempotencji żądania — podwójne kliknięcie „Zatwierdź korektę” nie tworzy drugiej korekty.
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(80)
  operation   Operation          @relation(fields: [operationId], references: [id], onDelete: Restrict)
  revisions   DocumentRevision[]

  @@index([operationId])
  @@index([createdAt])
  @@map("corrections")
}

model DocumentRevision {
  id           String      @id @default(uuid(7)) @db.Uuid
  operationId  String      @map("operation_id") @db.Uuid
  documentId   String?     @map("document_id") @db.Uuid
  correctionId String?     @map("correction_id") @db.Uuid
  field        String      @db.VarChar(80)
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String      @map("created_by_id") @db.Uuid
  operation    Operation   @relation(fields: [operationId], references: [id], onDelete: Restrict)
  document     Document?   @relation(fields: [documentId], references: [id])
  correction   Correction? @relation(fields: [correctionId], references: [id])

  @@index([operationId, createdAt])
  @@map("document_revisions")
}

// ============================================================================
// Inwentaryzacja i zamknięcie okresu
// ============================================================================

model InventoryPeriod {
  id          String          @id @default(uuid(7)) @db.Uuid
  warehouseId String          @map("warehouse_id") @db.Uuid
  /// Miesiąc RRRR-MM.
  period      String          @db.Char(7)
  status      InventoryStatus @default(OPEN)
  openedAt    DateTime        @default(now()) @map("opened_at") @db.Timestamptz(3)
  openedById  String          @map("opened_by_id") @db.Uuid
  closedAt    DateTime?       @map("closed_at") @db.Timestamptz(3)
  closedById  String?         @map("closed_by_id") @db.Uuid
  autoClosed  Boolean         @default(false) @map("auto_closed")
  operationId String?         @unique @map("operation_id") @db.Uuid
  lines       Json?
  version     Int             @default(1)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, period])
  @@map("inventory_periods")
}

// ============================================================================
// Audyt (append-only), powiadomienia, idempotencja, kopie zapasowe
// ============================================================================

/// Centralny dziennik audytu. UPDATE / DELETE zablokowane wyzwalaczem (migracja 0001).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  ts          DateTime @default(now()) @db.Timestamptz(3)
  userId      String?  @map("user_id") @db.Uuid
  userEmail   String?  @map("user_email") @db.VarChar(254)
  action      String   @db.VarChar(60)
  entity      String   @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.VarChar(80)
  warehouseId String?  @map("warehouse_id") @db.Uuid
  before      Json?
  after       Json?
  reason      String?
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  requestId   String?  @map("request_id") @db.VarChar(64)

  @@index([ts])
  @@index([entity, entityId])
  @@index([userId, ts])
  @@index([warehouseId, ts])
  @@map("audit_log")
}

model NotificationSetting {
  userId         String            @map("user_id") @db.Uuid
  event          NotificationEvent
  enabled        Boolean           @default(false)
  /// Administrator włącza możliwość powiadomień dla użytkownika.
  allowedByAdmin Boolean           @default(false) @map("allowed_by_admin")
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, event])
  @@map("notification_settings")
}

/// Kolejka poczty z ponowieniami — błąd wysyłki nie cofa operacji magazynowej.
model MailOutbox {
  id            String     @id @default(uuid(7)) @db.Uuid
  template      String     @db.VarChar(60)
  toAddress     String     @map("to_address") @db.VarChar(254)
  subject       String     @db.VarChar(250)
  payload       Json
  status        MailStatus @default(QUEUED)
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?    @map("last_error")
  providerId    String?    @map("provider_id") @db.VarChar(120)
  eventRef      String?    @map("event_ref") @db.VarChar(120)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt        DateTime?  @map("sent_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("mail_outbox")
}

model IdempotencyRecord {
  key            String   @id @db.VarChar(80)
  userId         String   @map("user_id") @db.Uuid
  route          String   @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_records")
}

model BackupRun {
  id                String       @id @default(uuid(7)) @db.Uuid
  kind              BackupKind
  status            BackupStatus @default(RUNNING)
  startedAt         DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz(3)
  primaryPath       String?      @map("primary_path")
  secondaryPath     String?      @map("secondary_path")
  sizeBytes         BigInt?      @map("size_bytes")
  sha256            String?      @db.Char(64)
  verifiedAt        DateTime?    @map("verified_at") @db.Timestamptz(3)
  restoreTestedAt   DateTime?    @map("restore_tested_at") @db.Timestamptz(3)
  restoreTestResult String?      @map("restore_test_result")
  error             String?

  @@index([startedAt])
  @@map("backup_runs")
}

/// Planer zakupów: plan dzienny (MP) magazynu — jedyna wartość planera wpisywana ręcznie; wykonanie, tony, ceny,
/// km, transport i kursy są liczone z dokumentów (PZ / PW / TR). Zmiany planu w dzienniku audytu (PLAN_UPDATED).
model PurchasePlan {
  id          String    @id @default(uuid(7)) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  day         DateTime  @db.Date
  planMp      Decimal   @map("plan_mp") @db.Decimal(12, 2)
  note        String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String    @map("updated_by_id") @db.Uuid
  version     Int       @default(1)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, day])
  @@map("purchase_plans")
}
