{
  "name": "resinvest-erp-4",
  "version": "4.0.0-alpha.1",
  "private": true,
  "description": "ResInvest ERP 4 — system magazynowy i obrotu biomasą (PostgreSQL, NestJS, React, Tauri)",
  "author": "Mateusz Roesner",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:domain": "pnpm --filter @resinvest/domain run build",
    "typecheck": "pnpm run build:domain && pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm run build:domain && pnpm -r --workspace-concurrency=1 run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild"
    ]
  }
}
