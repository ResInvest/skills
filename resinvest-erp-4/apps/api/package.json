{
  "name": "@resinvest/api",
  "version": "4.0.0-alpha.1",
  "private": true,
  "description": "ResInvest ERP 4 — API (NestJS)",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "build": "pnpm run generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "pnpm run generate && vitest run",
    "seed": "node dist/seed/seed.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@resinvest/domain": "workspace:*",
    "cookie-parser": "^1.4.7",
    "docx": "^9.8.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
