# ResInvest ERP 4 — zmienne środowiskowe (wzór). Skopiuj do .env (lokalnie) albo ustaw w konfiguracji usługi.
# NIE zapisuj prawdziwych haseł ani kluczy w repozytorium.

# --- baza PostgreSQL (serwer aplikacji, dysk lokalny — nie udział sieciowy) ---
DATABASE_URL="postgresql://resinvest:CHANGE_ME@127.0.0.1:5432/resinvest?schema=public"

# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Publiczny adres aplikacji (linki w e-mailach, CORS). Produkcja: https://erp.resinvest.local
APP_URL=http://localhost:5173
# Dodatkowe dozwolone źródła CORS (lista po przecinku), np. klient Tauri: tauri://localhost
CORS_ORIGINS=
# Sieci, z których API przyjmuje żądania (LAN + pula FortiClient VPN), CIDR po przecinku; puste = bez ograniczeń (tylko dev)
ALLOWED_NETWORKS=
# Adresy zaufanych proxy (Nginx) dla nagłówka X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1

# --- bezpieczeństwo ---
# Domeny e-mail kont firmowych
COMPANY_DOMAINS=resinvest.group
# Pierwszy administrator (tworzony przy inicjalizacji, jeśli brak administratora)
BOOTSTRAP_ADMIN_EMAIL=magazyn@resinvest.group
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
# Limit prób logowania w 5 min (z jednego IP / na jedno konto)
LOGIN_RATE_PER_IP=20
LOGIN_RATE_PER_EMAIL=8

# --- poczta (Resend API / SMTP / file) ---
# Produkcja (zalecane): główny kanał Resend API, zapasowy SMTP Resend — ten sam klucz API jest hasłem SMTP.
#   EMAIL_TRANSPORT=resend
#   EMAIL_FALLBACK_TRANSPORT=smtp
#   RESEND_API_KEY=re_...            ← klucz z panelu Resend; wpisuje go instalator / administrator, NIGDY do repozytorium
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465                    ← 465 = SSL; 587 = STARTTLS
#   SMTP_USER=resend
#   SMTP_PASS=re_...                 ← ten sam klucz co RESEND_API_KEY
#   EMAIL_FROM musi używać domeny zweryfikowanej w Resend (rekordy DNS: SPF, DKIM).
# Własny serwer pocztowy firmy: EMAIL_TRANSPORT=smtp i jego SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS.
# Lokalnie i w testach: file — wiadomości jako pliki .eml w MAIL_FILE_DIR, nic nie wychodzi.
EMAIL_TRANSPORT=file
EMAIL_FALLBACK_TRANSPORT=none
EMAIL_FROM="ResInvest ERP <erp@resinvest.group>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Katalog plików .eml dla EMAIL_TRANSPORT=file
MAIL_FILE_DIR=./data/mail
# Ważność linków: zaproszenie (godziny), reset hasła (minuty)
INVITE_HOURS=72
RESET_MINUTES=60

# --- kopie zapasowe (dysk firmowy; dwa niezależne katalogi) ---
BACKUP_PRIMARY_DIR=
BACKUP_SECONDARY_DIR=
BACKUP_KEEP_DAYS=30
